# Session signing (generate: openssl rand -base64 32) — required from Phase 2 (Auth.js)
NEXTAUTH_SECRET=replace-me-with-a-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# Upstream API root including /api/v1 — server only, never expose to the browser
JIWAMBE_API_BASE_URL=http://127.0.0.1:18080/api/v1

# Enable MSW for outbound server fetch in local dev and preview demos (set 0 or unset for real API)
MOCK_JIWAMBE_API=1

# --- Production / real API (MOCK_JIWAMBE_API=0) ---
# Never set E2E=1 in production or preview.

# Playwright / E2E only (Playwright starts the app via e2e/run-dev-e2e.cjs; pnpm test:e2e frees port 3100 first)
# E2E=1
# E2E_NEXT_PORT=3100
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100

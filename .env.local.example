# Session signing (generate: openssl rand -base64 32) — required from Phase 2 (Auth.js)
NEXTAUTH_SECRET=replace-me-with-a-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# Upstream API root including /api/v1 — server only, never expose to the browser
JIWAMBE_API_BASE_URL=http://127.0.0.1:18080/api/v1

# Enable MSW for outbound server fetch in local dev and preview demos (set 0 or unset for real API)
MOCK_JIWAMBE_API=1

# --- Production / real API (MOCK_JIWAMBE_API=0) ---
# Never set E2E=1 in production or preview.

# Presigned document upload host(s) for CSP connect-src (space-separated origins)
# DOCUMENT_UPLOAD_CONNECT_SRC=https://your-bucket.s3.amazonaws.com

# Deferred security pipeline (not wired yet — see docs/implementation-plan.md#security-pipeline-deferred--document-before-implement):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_ENABLED=1

# Playwright / E2E only (Playwright starts the app via e2e/run-dev-e2e.cjs; pnpm test:e2e frees port 3100 first)
# E2E=1
# E2E_NEXT_PORT=3100
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100

# Sentry (optional locally; required in production)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=          # DSN is public-by-design (not a secret)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=               # CI only — source map upload; never commit
# SENTRY_ENVIRONMENT=development   # or VERCEL_ENV in deploy
# SENTRY_TRACES_SAMPLE_RATE=0.1    # prod default; 1.0 in dev when enabled
# SENTRY_ENABLED=1                 # explicit opt-in for local debugging

# Structured logging (on in production; opt-in locally)
# STRUCTURED_LOGGING_ENABLED=1
# LOG_LEVEL=info                   # info | warn | error
